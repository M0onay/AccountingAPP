<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="1000.0" stylesheets="@AppDesign.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Main.Controller">
   <top>
      <Label text="ACCOUNTING APP" BorderPane.alignment="CENTER" />
   </top>
   <center>
      <TableView fx:id="journalTable" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="dateColumn" prefWidth="103.0" text="DATE" />
          <TableColumn fx:id="accountColumn" prefWidth="222.0" text="ACCOUNT TITLE" />
            <TableColumn fx:id="debitColumn" prefWidth="75.0" text="DEBIT" />
            <TableColumn fx:id="creditColumn" minWidth="4.0" prefWidth="75.0" text="CREDIT" />
            <TableColumn fx:id="noteColumn" prefWidth="169.0" text="NOTE" />
        </columns>
      </TableView>
   </center>
   <right>
      <VBox fillWidth="true" prefHeight="483.0" prefWidth="355.0" spacing="5.0" BorderPane.alignment="TOP_CENTER">
         <children>
            <HBox alignment="TOP_CENTER" prefHeight="19.0" prefWidth="355.0">
               <children>
                  <Label alignment="CENTER" contentDisplay="CENTER" text="ACCOUNTING" />
               </children>
            </HBox>
            <VBox alignment="TOP_CENTER" prefHeight="12.0" prefWidth="355.0">
               <children>
                  <Label fx:id="ErrorLabel" text="" visible="false" managed="false" />
               </children>
            </VBox>
            <Label prefHeight="16.0" prefWidth="38.0" text="DATE" />
            <TextField fx:id="dateTextField" maxWidth="Infinity" prefHeight="25.0" prefWidth="286.0" promptText="mm/dd/yyyy" />
            <Label text="ACCOUNT TITLE" />
            <ComboBox fx:id="actTitleCB" maxWidth="Infinity" prefHeight="25.0" prefWidth="364.0" promptText="Transaction Type" />
            <Label fx:id="paidbylabel" text="PAID BY" visible="false" />
            <ComboBox fx:id="paidby" maxWidth="Infinity" prefHeight="25.0" prefWidth="365.0" promptText="PAYMENT METHOD" visible="false" />
            <Button fx:id="back" mnemonicParsing="false" onAction="#backTransaction" text="BACK" visible="false" />
            <Label text="AMOUNT" />
            <TextField fx:id="amountTextField" maxWidth="Infinity" />
            <Label text="NOTE" />
            <TextField fx:id="noteTextField" maxWidth="Infinity" promptText="OPTIONAL" />
            <VBox alignment="TOP_CENTER" prefHeight="369.0" prefWidth="355.0" spacing="10.0" VBox.vgrow="ALWAYS">
               <children>
                  <Button fx:id="AddButton" mnemonicParsing="false" onAction="#AddTransaction" prefHeight="25.0" prefWidth="127.0" text="ADD TRANSACTION" />
                  <Button fx:id="ledgerButton" mnemonicParsing="false" onAction="#openLedger" prefHeight="25.0" prefWidth="127.0" text="LEDGER" />
                  <Button fx:id="TBButton" mnemonicParsing="false" onAction="#openTrialBalance" prefHeight="25.0" prefWidth="127.0" text="TRIAL BALANCE" />
                  <Button fx:id="GenerateButton" mnemonicParsing="false" onAction="#GenerateReport" prefWidth="127.0" text="GENERATE REPORT" />
               </children>
            </VBox>
         </children>
      </VBox>
   </right>
</BorderPane>
