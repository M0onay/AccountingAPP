<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Main.Controller">
   <top>
      <Label text="ACCOUNTING APP" BorderPane.alignment="CENTER" />
   </top>
   <center>
      <TableView prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn prefWidth="103.0" text="DATE" />
          <TableColumn prefWidth="222.0" text="ACCOUNT TITLE" />
            <TableColumn prefWidth="75.0" text="DEBIT" />
            <TableColumn minWidth="4.0" prefWidth="75.0" text="CREDIT" />
            <TableColumn prefWidth="169.0" text="NOTE" />
        </columns>
      </TableView>
   </center>
   <right>
      <VBox prefHeight="483.0" prefWidth="355.0" BorderPane.alignment="TOP_CENTER">
         <children>
            <HBox alignment="TOP_CENTER" prefHeight="19.0" prefWidth="355.0">
               <children>
                  <Label alignment="CENTER" contentDisplay="CENTER" text="ACCOUNTING" />
               </children>
            </HBox>
            <Label prefHeight="17.0" prefWidth="30.0" text="DATE" />
            <TextField fx:id="dateTextField" prefHeight="25.0" prefWidth="286.0" promptText="mm/dd/yyyy" />
            <Label text="ACCOUNT TITLE" />
            <ComboBox fx:id="actTitleCB" prefHeight="25.0" prefWidth="364.0" promptText="Transaction Type" />
            <Label fx:id="paidbylabel" text="PAID BY" visible="false" />
            <ComboBox fx:id="paidby" prefHeight="25.0" prefWidth="365.0" visible="false" />
            <Button fx:id="back" mnemonicParsing="false" text="BACK" visible="false" />
            <Label text="AMOUNT" />
            <TextField fx:id="amountTextField" />
            <Label text="NOTE" />
            <TextField fx:id="noteTextField" promptText="OPTIONAL" />
            <VBox alignment="TOP_CENTER" prefHeight="369.0" prefWidth="355.0">
               <children>
                  <Button fx:id="AddButton" mnemonicParsing="false" onAction="#AddTransaction" text="ADD TRANSACTION" />
                  <Button fx:id="EditButton" mnemonicParsing="false" onAction="#EditTransaction" text="EDIT TRANSACTION" />
                  <Button fx:id="GenerateButton" mnemonicParsing="false" onAction="#GenerateReport" text="GENERATE REPORT" />
               </children>
            </VBox>
         </children>
      </VBox>
   </right>
</BorderPane>
