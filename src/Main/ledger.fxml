<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="1000.0" stylesheets="@AppDesign.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Main.LedgerController">
   <top>
      <Label text="LEDGER" BorderPane.alignment="CENTER" />
   </top>
   <center>
      <ScrollPane fx:id="PaneTable" fitToWidth="true" BorderPane.alignment="CENTER">
         <content>
            <VBox fx:id="ledgerContainer" prefHeight="482.0" prefWidth="643.0" />
         </content>
      </ScrollPane>
   </center>
   <right>
      <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="355.0" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="TOP_CENTER" text="ACCOUNTING" />
            <VBox prefHeight="211.0" prefWidth="355.0">
               <children>
                  <Label text="DATE" />
                  <TextField fx:id="dateTextField" promptText="mm/dd/yyyy" />
                  <Label text="ACCOUNT TITLE" />
                  <ComboBox fx:id="actTitleCB" prefHeight="25.0" prefWidth="369.0" promptText="Transaction Type" />
                  <Label fx:id="paidbylabel" text="PAID BY" visible="false" />
                  <ComboBox fx:id="paidby" prefHeight="25.0" prefWidth="388.0" promptText="PAYMENT METHOD" visible="false" />
                  <Button fx:id="back" mnemonicParsing="false" onAction="#backTransaction" text="BACK" visible="" />
                  <Label text="AMOUNT" />
                  <TextField fx:id="amountTextField" />
                  <Label text="NOTE" />
                  <TextField fx:id="noteTextField" promptText="OPTIONAL" />
               </children>
            </VBox>
            <VBox alignment="TOP_CENTER" prefHeight="257.0" prefWidth="355.0">
               <children>
                  <Button fx:id="AddButton" mnemonicParsing="false" onAction="#AddTransaction" prefWidth="127.0" text="ADD TRANSACTION" />
                  <Button fx:id="journalButton" mnemonicParsing="false" onAction="#openJournal" prefWidth="127.0" text="JOURNAL" />
                  <Button fx:id="TBButton" mnemonicParsing="false" onAction="#openTrialBalance" prefWidth="127.0" text="TRIAL BALANCE" />
                  <Button fx:id="GenerateButton" mnemonicParsing="false" onAction="#GenerateReport" prefWidth="127.0" text="GENERATE REPORT" />
               </children>
            </VBox>
         </children>
      </VBox>
   </right>
</BorderPane>
